rules_version = '2';

// Deploy via Firebase Console > Firestore Database > Rules, or `firebase deploy --only firestore:rules`.
// Access requires: (1) signed in with Firebase Auth, and (2) email present in config/allowlist.emails.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAllowListed() {
      return isSignedIn()
        && request.auth.token.email in get(/databases/$(database)/documents/config/allowlist).data.emails;
    }

    // Allow-list document: readable by any signed-in user (needed to check membership), never client-writable.
    match /config/allowlist {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Private per-user templates: only the owning, allow-listed user may read/write.
    match /users/{uid}/templates/{templateId} {
      allow read, write: if isAllowListed() && request.auth.uid == uid;
    }

    // Private per-user instructions: owner has full access.
    match /users/{uid}/instructions/{instructionId} {
      allow read, write: if isAllowListed() && request.auth.uid == uid;
    }

    // Collection-group rule enabling the "browse shared instructions" query across all users.
    // Any allow-listed user may read an instruction document if it is flagged as shared;
    // writes still go through the owner-scoped rule above.
    match /{path=**}/instructions/{instructionId} {
      allow read: if isAllowListed() && resource.data.isShared == true;
    }
  }
}
