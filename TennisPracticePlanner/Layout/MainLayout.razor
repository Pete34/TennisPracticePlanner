@inherits LayoutComponentBase
<div class="relative flex min-h-screen flex-col bg-[#10161d] md:flex-row">
    <div class="bg-[#111a22] md:sticky md:top-0 md:h-screen md:w-64">
        <NavMenu />
    </div>

    <main class="min-w-0 flex-1">
        <div class="flex h-14 items-center border-b border-[#304252] bg-[#18222c]/95 px-5 backdrop-blur">
            <span class="text-sm font-bold uppercase tracking-widest text-[#a9e1f5]">Practice Session Builder</span>
        </div>

        <article class="px-5 py-6 md:px-8">
            @Body
        </article>
    </main>
</div>
