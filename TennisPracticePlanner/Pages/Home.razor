@page "/"
@inject ITennisPracticeDataService DataService

<PageTitle>Home</PageTitle>

<div class="mx-auto max-w-6xl pb-8">
	<section class="mb-5 border border-court-100 bg-white p-6 shadow-sm md:p-8">
		<p class="mb-2 text-xs font-bold uppercase tracking-widest text-peach-600">Your practice, organized</p>
		<h1 class="mb-3 font-['Bebas_Neue'] text-5xl tracking-wide text-court-900 md:text-6xl">Tennis Practice Planner</h1>
		<p class="mb-6 max-w-2xl text-lg leading-7 text-court-700">Create reusable drills, assemble full sessions, and track total duration in minutes.</p>

		<div class="flex flex-wrap gap-3">
			<a class="rounded-md bg-peach-500 px-4 py-2.5 text-sm font-bold text-white no-underline transition hover:bg-peach-600 focus:outline-none focus:ring-2 focus:ring-peach-300" href="/instructions">Manage Instructions</a>
			<a class="rounded-md bg-court-600 px-4 py-2.5 text-sm font-bold text-white no-underline transition hover:bg-court-700 focus:outline-none focus:ring-2 focus:ring-court-500" href="/templates">Build Practice Sessions</a>
		</div>
	</section>

	<section class="grid gap-4 md:grid-cols-2">
		<article class="border border-court-100 bg-white p-5 shadow-sm">
			<h2 class="text-sm font-bold uppercase tracking-wide text-court-700">Reusable Instructions</h2>
			<p class="my-2 text-4xl font-bold text-court-600">@InstructionCount</p>
			<p class="mb-0 text-sm leading-6 text-court-700">Save drills once and reuse them across sessions.</p>
		</article>

		<article class="border border-court-100 bg-white p-5 shadow-sm">
			<h2 class="text-sm font-bold uppercase tracking-wide text-court-700">Practice Templates</h2>
			<p class="my-2 text-4xl font-bold text-court-600">@TemplateCount</p>
			<p class="mb-0 text-sm leading-6 text-court-700">Compose complete sessions and adjust each instruction copy independently.</p>
		</article>
	</section>
</div>

@code {
	private int InstructionCount { get; set; }
	private int TemplateCount { get; set; }

	protected override async Task OnInitializedAsync()
	{
		await DataService.InitializeAsync();

		List<ReusableInstruction> instructions = await DataService.GetReusableInstructionsAsync();
		List<PracticeTemplate> practiceTemplates = await DataService.GetPracticeTemplatesAsync();

		InstructionCount = instructions.Count;
		TemplateCount = practiceTemplates.Count;
	}
}
